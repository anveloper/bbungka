# Gemini API 키 (Google AI Studio에서 발급) — @ai-sdk/google가 자동으로 읽음
GOOGLE_GENERATIVE_AI_API_KEY=

# (선택) 사용할 Gemini 모델. 미설정 시 gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Neon(Postgres) 연결 문자열 — Vercel Neon 통합이 자동 주입 (로컬은 `vercel env pull`)
DATABASE_URL=

# cron 엔드포인트 보호용 시크릿 (Vercel env + GitHub Actions secret에 동일 값)
CRON_SECRET=
